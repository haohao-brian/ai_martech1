# ==============================================================================
# MAMBA Environment Variables Template
# ==============================================================================
# SECURITY WARNING: 
# - Copy this file to .env and fill in your actual credentials
# - NEVER commit .env to version control
# - Ensure .env is in .gitignore
# - Set file permissions: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# eBay SQL Server Connection (via SSH Tunnel)
# ------------------------------------------------------------------------------
# SSH Tunnel Configuration
EBY_SSH_HOST=220.128.138.146
EBY_SSH_USER=your_ssh_username
EBY_SSH_PASSWORD=your_ssh_password

# SQL Server Target (accessed through SSH tunnel)
EBY_SQL_HOST=125.227.84.85
EBY_SQL_PORT=1433
EBY_LOCAL_PORT=1433

# SQL Server Database Credentials
EBY_SQL_DATABASE=MAMBATEK
EBY_SQL_USER=your_sql_username
EBY_SQL_PASSWORD=your_sql_password

# ------------------------------------------------------------------------------
# Cyberbiz API Configuration
# ------------------------------------------------------------------------------
CBZ_API_TOKEN=your_cyberbiz_api_token
CBZ_API_URL=https://api.cyberbiz.io
CBZ_SHOP_ID=your_shop_id

# ------------------------------------------------------------------------------
# Amazon API Configuration
# ------------------------------------------------------------------------------
AMZ_ACCESS_KEY=your_amazon_access_key
AMZ_SECRET_KEY=your_amazon_secret_key
AMZ_REGION=us-west-2

# ------------------------------------------------------------------------------
# OpenAI API Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key

# ------------------------------------------------------------------------------
# PostgreSQL Database (if used)
# ------------------------------------------------------------------------------
PGHOST=your_postgres_host
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_postgres_username
PGPASSWORD=your_postgres_password
PGSSLMODE=require

# ------------------------------------------------------------------------------
# Supabase PostgreSQL (app_data deployment)
# ------------------------------------------------------------------------------
# Used for Posit Connect deployment when DuckDB is not available
# Get credentials from: Supabase Dashboard > Project Settings > Database
SUPABASE_DB_HOST=db.your_project_ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development  # development, staging, production
APP_DEBUG=false      # Set to true only in development
APP_LOG_LEVEL=info   # debug, info, warning, error

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
# Session secret for web applications
SESSION_SECRET=generate_a_random_string_here

# Encryption key for sensitive data
ENCRYPTION_KEY=generate_a_strong_key_here

# ------------------------------------------------------------------------------
# Optional: Monitoring and Analytics
# ------------------------------------------------------------------------------
# SENTRY_DSN=your_sentry_dsn
# DATADOG_API_KEY=your_datadog_api_key
# GA_TRACKING_ID=your_google_analytics_id

# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.template .env
# 2. Fill in all required values in .env
# 3. Set permissions: chmod 600 .env
# 4. Test connection: Rscript test_mamba_connection.R
# 
# For SSH key authentication (more secure than password):
# 1. Generate SSH key: ssh-keygen -t ed25519 -C "mamba-etl"
# 2. Copy to server: ssh-copy-id your_username@220.128.138.146
# 3. Remove EBY_SSH_PASSWORD variable and use key auth
# ==============================================================================